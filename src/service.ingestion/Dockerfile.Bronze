FROM golang:1.26.0-alpine AS builder
ENV CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ ./cmd/
COPY external/ ./external/
COPY internal/ ./internal/
COPY pkg/ ./pkg/
RUN go build -ldflags="-s -w" -o bronze-worker ./cmd/bronze-worker

FROM alpine:3.22
RUN apk --no-cache add ca-certificates && \
    addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup
WORKDIR /app
COPY --from=builder /app/bronze-worker .
RUN chown -R appuser:appgroup /app

USER appuser
EXPOSE 8080 8081
ENTRYPOINT ["./bronze-worker"]
STOPSIGNAL SIGTERM
