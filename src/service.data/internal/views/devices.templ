package views

import (
	"service.data/internal/components"
	"service.data/internal/core/dtos"
)

templ DevicesView(stats []dtos.TileDto, devices []dtos.DeviceStateDto) {
	@mainLayout("TIS - Devices") {
		<article class="devices-view">
			@components.DeviceTiles(stats)
			<label>
				<input
					class="search-input font-semibold"
					type="search"
					name="q"
					placeholder="Search devices..."
					hx-get="/devices/search"
					hx-trigger="keyup changed delay:50ms"
					hx-target="#device-list"
					hx-sync="this:replace"
				/>
			</label>
			@components.DeviceList(devices)
		</article>
	}
}
