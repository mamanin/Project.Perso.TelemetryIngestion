package components

import (
	"service.data/internal/core/dtos"
)

templ DeviceTiles(stats []dtos.TileDto) {
	<div class="device-tiles-container">
	  for _, tile := range stats {
      @Tile(tile)
    }
	</div>
}

templ DeviceList(devices []dtos.DeviceStateDto) {
	<div class="device-list-container">
		if len(devices) == 0 {
			<p class="no-results size-lg">No devices found.</p>
		} else {
			<ul class="device-list">
				for _, device := range devices {
					@DeviceItem(device)
				}
			</ul>
		}
	</div>
}

templ DeviceItem(device dtos.DeviceStateDto) {
	<li class="device-item">
		<span class="device-name font-semibold">{ device.Id }</span>
		for _, s := range device.Sensors {
			<span class="device-type text-caption size-sm">{ s }</span>
		}
		<time class="device-id text-code" datetime={ device.Heartbeat } data-format="HH:mm">00:00</time>
	</li>
}
